# ==================================================================== DEPLOY SETTINGS (SECRET)
# For npm run deploy:live and npm run verify.
# Copy this file to dev/settings/deploy.env and fill it in. deploy.env is git-ignored:
# never commit it, never send it to anyone, never paste the key into settings/.env.

# Private key of the wallet that pays gas and sends the deploy transactions.
# Use a fresh wallet that only holds enough BNB for gas.
DEPLOYER_PRIVATE_KEY=0x

# RPC of the target chain (BSC mainnet below). The chain id read from it picks the network in networks.json.
DEPLOY_RPC_URL=https://bsc-dataseed.bnbchain.org

# Owner of every contract, also the proxy admin. Leave empty to use the deployer.
# Prefer a safer wallet (hardware wallet or multisig) than the deployer.
DEPLOY_OWNER=

# Only for npm run verify -- --submit. Free key from https://etherscan.io/myapikey (one key covers BSC).
ETHERSCAN_API_KEY=
