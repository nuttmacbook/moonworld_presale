# ==================================================================== WEBSITE SETTINGS
# SETTINGS. Copy to settings/.env (never commit .env). On Vercel, add every line below under
# Project → Settings → Environment Variables, then Redeploy (VITE_ values are built into the page).
# Everything here ends up in the public JavaScript: never put a private key or secret here.

# --- Wallet / network (kitbox). Test project id of Nutt: replace with the client's own before launch.
VITE_PROJECT_ID=4b2194bd0448ba60db7cf89f36a94c0f
VITE_CHAIN=bsc

# --- Name, texts and domain (used in <head>, header, footer and share previews)
VITE_APP_NAME=Moon World
VITE_APP_TAGLINE=Claim your MWLD
VITE_APP_DESCRIPTION=Claim your unlocked MWLD from the Moon World presale.
VITE_SITE_URL=https://presale.moonworld.app

# --- Maintenance page: on | off. Bypass word: open ?bypass=<word> to see the real site in that tab.
VITE_MAINTENANCE=off
VITE_MAINTENANCE_MESSAGE=
VITE_MAINTENANCE_BYPASS=

# --- Contracts that already live on BNB Chain (not deployed by this project). Symbols and decimals are read from the tokens.
# MWLD token
VITE_TOKEN_ADDRESS=0x7c25440667c23873d7C61aA12dF669783ee16aB8
# Claim contract: getPersonalData(account), unlockToken(account)
VITE_CLAIM_CONTRACT=0xD1D154a2b207Ce61F33549dC1Aa0302E9C322878
# Presale contract (ended): getUserInfo(paymentToken, [account]) gives how much the wallet bought
VITE_PRESALE_CONTRACT=0xc5B9E40735a60f25b5D9A7b437C2FC64Fb077Da0
# Token the presale was paid in (USDT on BSC): bought, balance and referral rewards are in this token
VITE_PAYMENT_TOKEN=0x55d398326f99059fF775485246999027B3197955

# --- Links
VITE_LANDING_URL=https://moonworld.app
VITE_SUPPORT_EMAIL=support@moonworld.app
# Social links: leave empty to hide that icon
VITE_TELEGRAM_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=
